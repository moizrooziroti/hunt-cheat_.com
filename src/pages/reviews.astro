---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { reviews } from '../data/reviews';
import { Card, CardContent } from '@/components/starwind/card';
import { Button } from '@/components/starwind/button';
import Icon from '../components/icons/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ROUTES } from '../utils/path';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];

function starRow(rating: number) {
  const full = Math.max(1, Math.min(5, Math.round(rating)));
  return { full, empty: 5 - full };
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: t.reviews.title,
      description: t.reviews.subtitle,
      url: '/reviews/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-t border-border bg-muted/15 py-16 md:py-24" aria-labelledby="reviews-page-title">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} class="mb-8" />

      <SectionHeader
        eyebrow={t.reviews.eyebrow}
        title={t.reviews.title}
        desc={t.reviews.subtitle}
        titleId="reviews-page-title"
        heading="h1"
      />

      {
        reviews.length === 0 ? (
          <Card class="mt-10 border-dashed">
            <CardContent class="py-12 text-center">
              <Icon name="messageCircle" size={28} class="mx-auto text-muted-foreground" aria-hidden="true" />
              <p class="mt-4 text-lg font-semibold text-foreground">{t.reviews.emptyTitle}</p>
              <p class="mx-auto mt-2 max-w-md text-sm text-muted-foreground">{t.reviews.emptyBody}</p>
              <div class="mt-8 flex flex-wrap justify-center gap-3">
                <Button as="a" href={ROUTES.products} variant="primary">
                  View products
                  <Icon name="arrowRight" size={16} />
                </Button>
                <Button as="a" href={ROUTES.blog} variant="outline">
                  Read blogs
                </Button>
              </div>
            </CardContent>
          </Card>
        ) : (
          <>
            <p class="mt-8 text-center text-xs text-muted-foreground">{t.reviews.permissionNote}</p>

            <ul class="mt-10 grid list-none gap-5 p-0 md:grid-cols-2" aria-label="Published buyer notes">
              {reviews.map((review) => {
                const stars = starRow(review.rating);
                return (
                  <li>
                    <Card class="h-full border-border/80 shadow-xs">
                      <CardContent class="flex h-full flex-col gap-4 py-6">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                          <div>
                            <p class="font-semibold text-foreground">{review.name}</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                              {review.product ? `${review.product} · ` : ''}
                              {review.date}
                            </p>
                          </div>
                          <div
                            class="inline-flex items-center gap-0.5 text-sm"
                            role="img"
                            aria-label={`${review.rating} out of 5 stars`}
                          >
                            {Array.from({ length: stars.full }).map(() => (
                              <span class="text-primary" aria-hidden="true">
                                ★
                              </span>
                            ))}
                            {Array.from({ length: stars.empty }).map(() => (
                              <span class="text-muted-foreground/40" aria-hidden="true">
                                ★
                              </span>
                            ))}
                          </div>
                        </div>

                        <blockquote class="border-none text-sm leading-relaxed text-foreground">
                          <p>&ldquo;{review.quote}&rdquo;</p>
                        </blockquote>

                        {review.reply && (
                          <div class="mt-auto rounded-lg border border-border/80 bg-muted/40 px-4 py-3">
                            <p class="text-xs font-medium text-primary">
                              {review.reply.author}
                              {review.reply.date ? ` · ${review.reply.date}` : ''}
                            </p>
                            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{review.reply.body}</p>
                          </div>
                        )}
                      </CardContent>
                    </Card>
                  </li>
                );
              })}
            </ul>

            <div class="mt-12 flex flex-wrap justify-center gap-3">
              <Button as="a" href={ROUTES.products} variant="primary">
                View products
                <Icon name="arrowRight" size={16} />
              </Button>
              <Button as="a" href="/support/" variant="outline">
                Support
              </Button>
            </div>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
