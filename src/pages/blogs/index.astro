---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogMatchesQuery,
  blogPosts,
  getFeaturedBlogPost,
  getNonFeaturedBlogPosts,
} from '../../data/blog';
import { BLOG_FILTER_CATEGORIES } from '../../data/blog/categories';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { Input } from '@/components/starwind/input';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/blogs/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blogs', path: '/blogs/' },
];

const featured = getFeaturedBlogPost();
const gridPosts = getNonFeaturedBlogPosts();
const lcpImage = featured?.image ?? blogPosts[0]!.image;

const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
const initialQuery = Astro.url.searchParams.get('q') ?? '';
const trimmedQuery = initialQuery.trim();
const countVisibleForQuery = (q: string) => {
  const norm = q.trim().toLowerCase();
  if (!norm) return gridPosts.length + (featured ? 1 : 0);
  let n = gridPosts.filter((post) => blogMatchesQuery(post, norm)).length;
  if (featured && blogMatchesQuery(featured, norm)) n += 1;
  return n;
};
const initialVisibleCount = countVisibleForQuery(trimmedQuery);
const initialEmpty = trimmedQuery.length > 0 && initialVisibleCount === 0;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: t.blog.title,
      description: t.blog.subtitle,
      url: '/blogs/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" crossorigin="anonymous" fetchpriority="high" />

  <section class="py-8 md:py-12" data-blog-index>
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      {
        featured && (
          <div
            data-blog-featured
            class:list={[trimmedQuery && !blogMatchesQuery(featured, trimmedQuery) && 'hidden']}
            hidden={trimmedQuery && !blogMatchesQuery(featured, trimmedQuery) ? true : undefined}
          >
            <BlogCard post={featured} index={0} eager showDate layout="featured" />
          </div>
        )
      }
    </div>
  </section>

  <section class="border-y border-border bg-muted/20 py-12 md:py-16" aria-labelledby="blog-latest-title">
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h1 id="blog-latest-title" class="section-header__title">{t.blog.latestTitle}</h1>
        <p class="section-header__subtitle">{t.blog.latestSubtitle}</p>
      </header>

      <div class="mt-8 max-w-xl">
        <label for="blog-search" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
          {t.blog.searchLabel}
        </label>
        <div class="relative mt-1.5">
          <Icon name="navBlog" size={16} class="pointer-events-none absolute left-3 top-1/2 z-10 -translate-y-1/2 text-muted-foreground" aria-hidden="true" />
          <Input
            id="blog-search"
            type="search"
            name="q"
            value={initialQuery}
            placeholder={t.blog.searchPlaceholder}
            autocomplete="off"
            class="pl-9"
            aria-label={t.blog.searchLabel}
          />
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter articles by topic"
        >
          <button
            type="button"
            class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
            data-blog-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAllArticles}
          </button>
          {
            BLOG_FILTER_CATEGORIES.map((tag) => (
              <button
                type="button"
                class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                data-blog-filter={tag}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect />
      </div>

      <p
        id="blog-results-count"
        class:list={['mt-8 text-sm text-muted-foreground', !trimmedQuery && 'hidden']}
        role="status"
        aria-live="polite"
        data-blog-results-count
      >
        {trimmedQuery ? `${initialVisibleCount} article(s) match “${trimmedQuery}”.` : ''}
      </p>

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {gridPosts.map((post, index) => {
          const match = blogMatchesQuery(post, trimmedQuery);
          return (
            <BlogCard
              post={post}
              index={index}
              showDate
              class={trimmedQuery && !match ? 'hidden' : undefined}
            />
          );
        })}
      </div>

      <p
        id="blog-empty"
        class:list={['mt-10 text-center text-muted-foreground', !initialEmpty && 'hidden']}
        role="status"
        data-empty-filter={t.blog.emptyFilter}
        hidden={!initialEmpty}
      >
        {trimmedQuery ? 'No articles match this search.' : t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </Button>
      </div>
    </div>
  </section>

  <script>
    import { setupBlogIndexFromDom } from '../../scripts/blog-index.ts';

    const emptyEl = document.getElementById('blog-empty');
    const emptyDefault = emptyEl?.getAttribute('data-empty-filter') ?? 'No blogs match this filter.';
    setupBlogIndexFromDom(emptyDefault);
  </script>
</BaseLayout>
